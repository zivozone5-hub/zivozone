rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'rBlzUigQ6DhgD4CK6VX3tS43PS43'
        && request.auth.token.email == 'raefalbtish@gmail.com';
    }

    match /users/{userId} {
      allow read, create, update: if isOwner() || (request.auth != null && request.auth.uid == userId);
      allow delete: if false;
      match /activity/{eventId} {
        allow read, create: if isOwner() || (request.auth != null && request.auth.uid == userId);
        allow update, delete: if false;
      }
      match /zivozone/{docId} {
        allow read, create, update: if isOwner() || (request.auth != null && request.auth.uid == userId);
        allow delete: if false;
      }
    }

    match /players/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isOwner() || (
        request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['xp','coins','zivo','wins','losses','gamesPlayed','level','bestStreak','wallet','verified','verifiedScore']
        )
      );
      match /gameAttempts/{attemptId} {
        allow read, create: if isOwner() || (request.auth != null && request.auth.uid == uid);
        allow update: if false;
      }
      match /wallet/{doc} {
        allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
        allow write: if false;
      }
      match /events/{eventId} {
        allow read, create: if isOwner() || (request.auth != null && request.auth.uid == uid);
        allow update, delete: if false;
      }
      match /results/{resultId} {
        allow read, create: if isOwner() || (request.auth != null && request.auth.uid == uid);
        allow update, delete: if false;
      }
    }

    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /dailyChallenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /results/{resultId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /wallets/{userId} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == userId);
      allow write: if false;
    }
    match /leaderboard/{playerId} {
      allow read: if true;
      allow write: if false;
    }
    match /admins/{userId} {
      allow read: if isOwner() && request.auth.uid == userId;
      allow write: if false;
    }
    match /siteStats/visitors/{day}/{visitorId} {
      allow create, update: if request.auth != null;
      allow read: if isOwner();
      allow delete: if false;
    }
    match /siteStats/{document=**} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
