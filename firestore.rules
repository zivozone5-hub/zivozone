rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Private player profile. The UID is the ownership boundary.
    match /players/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp','zivo','coins','wins','gamesPlayed','level']);
      allow delete: if false;


      match /attempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == 'pending-server-validation'
          && !request.resource.data.keys().hasAny(['xp','coins','zivo','reward']);
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.event is string
          && request.resource.data.event.size() <= 80;
        allow update, delete: if false;
      }

      match /results/{resultId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status != 'verified';
        allow update: if false;
        allow delete: if false;
      }

      // Per-player ZIVOZONE state such as question history.
      match /zivozone/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // Server-managed content. The current static site uses challenges.js.
    // These collections are ready for a future admin/backend workflow.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /dailyChallenges/{challengeId} {
      allow read: if true;
      allow write: if false;
    }

    // Optional public sports cache, writable only by a trusted backend later.
    match /sports/{documentId} {
      allow read: if true;
      allow write: if false;
    }


    match /players/{userId}/walletTransactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
