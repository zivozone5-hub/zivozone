rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // V1229: an unverified e-mail must never grant admin rights.
    function isOwner() { return signedIn() && request.auth.token.email == 'raefalbtish@gmail.com' && request.auth.token.email_verified == true; }
    function isSelf(id) { return signedIn() && request.auth.uid == id; }
    function validWalletKeys() { return request.resource.data.keys().hasOnly(['zivo','createdAt','updatedAt','mode','lastRewardClaimId']); }
    // V1230.87 — progress sync (players/{uid}.xp/level/streak/... and the public leaderboard/{uid}
    // projection it feeds). Same honest trade-off already documented for ZIVO reward claims
    // elsewhere in this file: on the Spark plan there is no Cloud Functions layer to verify these
    // numbers server-side, so these rules bound each write (must not decrease, capped delta per
    // write) rather than cryptographically proving it — a real deterrent against a one-shot
    // "set my score to 999999999" forgery, not a guarantee against a patient attacker replaying many
    // small writes. That ceiling is deliberately well above any real single reward in economy.js
    // (the largest is 80 XP for a football epic clear) to tolerate several rewards debouncing into
    // one sync call, while still being far below what forging a top leaderboard spot would need.
    function validProgressUpdate() {
      let d = request.resource.data;
      let keys = d.diff(resource.data).affectedKeys();
      let prevXp = resource.data.get('xp', 0);
      let prevGames = resource.data.get('gamesPlayed', 0);
      return keys.hasOnly(['xp','level','streak','bestStreak','gamesPlayed','bestScore','updatedAt'])
        && d.updatedAt == request.time
        && d.xp is number && d.xp >= prevXp && d.xp - prevXp <= 500
        && d.level is number && d.level >= 1 && d.level <= 999
        && d.streak is number && d.streak >= 0 && d.streak <= 3660
        && d.bestStreak is number && d.bestStreak >= 0
        && d.gamesPlayed is number && d.gamesPlayed >= prevGames
        && d.bestScore is number && d.bestScore >= 0;
    }
    // Separate, narrower path for the handful of benign self-profile fields (setLanguage(),
    // Auth.update()'s name/language/age patches) — kept apart from validProgressUpdate() so
    // loosening one can never accidentally loosen the other.
    function validProfileUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['language','name','age','avatar','updatedAt'])
        && (!keys.hasAny(['language']) || (request.resource.data.language is string && request.resource.data.language.size() <= 5))
        && (!keys.hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() <= 24))
        && (!keys.hasAny(['age']) || (request.resource.data.age is number && request.resource.data.age >= 13 && request.resource.data.age <= 100))
        // V1230.129 — the avatar is a cosmetic, client-trusted pick (same low-stakes trust level as
        // achievements/badges, which are also purely client-derived) — not server-verified against
        // "earned" status; just size-capped so it can't be abused as a free-text storage channel.
        && (!keys.hasAny(['avatar']) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 32));
    }
    // auth.js's touchSession() — the existing "last seen" presence ping (players/{uid}.lastSeenAt/
    // lastSeenPath). Pre-existing, already-active write path; carved out here so the progress-sync
    // rules above don't accidentally break it.
    function validPresenceUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['lastSeenAt','lastSeenPath'])
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.lastSeenPath is string && request.resource.data.lastSeenPath.size() <= 100;
    }
    // The public leaderboard/{uid} projection: only name/level/xp/streak ever leave players/{uid}'s
    // private doc (never email) — see core/modules/leaderboard.js and auth.js's syncProgress().
    function validLeaderboardEntry(uid) {
      let d = request.resource.data;
      let prevXp = resource == null ? 0 : resource.data.get('xp', 0);
      return d.keys().hasOnly(['uid','name','level','xp','streak','avatar','updatedAt'])
        && d.uid == uid
        && d.name is string && d.name.size() <= 24
        && d.level is number && d.level >= 1 && d.level <= 999
        && d.xp is number && d.xp >= prevXp && d.xp - prevXp <= 500
        && d.streak is number && d.streak >= 0 && d.streak <= 3660
        && (!d.keys().hasAny(['avatar']) || (d.avatar is string && d.avatar.size() <= 32))
        && d.updatedAt == request.time;
    }
    // V1230.61 — reward-forgery hardening (see economy.js's startGameSession() for the full writeup).
    function validGameSessionKeys() { return request.resource.data.keys().hasOnly(['sessionId','gameId','startedAt']); }
    // V1230.68 — zero-cost client-side error tracking (see core/modules/runtime/error-tracker.js).
    // Anonymous-write like siteStats/visitors below (most runtime errors fire before/without a
    // signed-in user), size-capped on every field, write-once (no update/delete), admin-only read.
    function validErrorLogKeys() { return request.resource.data.keys().hasOnly(['type','message','stack','url','userAgent','lang','appVersion','uid','day','createdAt']); }
    function validErrorLog() {
      return validErrorLogKeys()
        && request.resource.data.type in ['error','unhandledrejection','manual']
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 3000
        && request.resource.data.url is string && request.resource.data.url.size() <= 200
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 10
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
        && request.resource.data.day is string && request.resource.data.day.size() <= 10
        && request.resource.data.createdAt == request.time
        // uid is never trusted blindly: either absent (anonymous visitor) or it must be the
        // writer's own authenticated uid — never someone else's, to stop one player from writing
        // error logs that frame another player's account.
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
    }
    function validGameSessionShape() {
      return request.resource.data.sessionId is string && request.resource.data.sessionId.size() > 5
        && request.resource.data.gameId is string && request.resource.data.gameId.size() > 0
        && request.resource.data.startedAt == request.time;
    }
    // V1230.59 — added light_escape_reward (per-world clear, Dark Room's new "Light Escape" game)
    // and light_escape_epic_reward (full 50-level clear).
    // V1230.60 — the bug flagged above is now fixed: beauty_epic_reward, forensic_epic_reward,
    // puzzle_epic_reward, story_epic_reward and health_epic_reward (each room's own Epic50
    // "full clear" bonus, credit(5,{type:'…_epic_reward'}) in beauty-room.js/forensic-case-core.js/
    // puzzle-room.js/rooms.js) were never in this list or in economy.js's matching switch, so every
    // one of those claims was silently rejected by credit() returning false before ever reaching
    // Firestore — confirmed by reading every live call site client-side, not just the client-side
    // reward policy table. horror_epic_reward is NOT added here: horror-room.js no longer calls it
    // at all (that mechanic was replaced by light_escape_epic_reward in 1230.59), so it is genuinely
    // dead and adding it would just be an unused allow-rule.
    // V1230.70 — football_epic_reward (football-room.js's new "Tactics Trainer" Epic50 game) added
    // here AND in economy.js's credit() switch in the SAME change, learning from the 1230.59/.60
    // history above: every previous room's epic reward was added to one side and not the other first.
    // V1230.128 — share_reward (share.js's rewardFirstShareToday(): one small ZIVO for the first
    // successful share action of the day, any channel) added here AND in economy.js's credit()
    // switch in the SAME change, learning from the 1230.59/.60/.70 history above.
    function rewardTypeValid() { return request.resource.data.type in ['challenge_reward','mission_reward','competition_reward','achievement_reward','story_reward','health_reward','beauty_reward','horror_reward','light_escape_reward','light_escape_epic_reward','beauty_epic_reward','forensic_epic_reward','puzzle_epic_reward','story_epic_reward','health_epic_reward','football_epic_reward','share_reward','legend_reward']; }
    // V1230.84 — unified every "finished a test/game perfectly" reward to a flat 5 ZIVO (challenge_reward
    // was 10; story/health/beauty/horror/light_escape_reward were 2). Must match economy.js's credit()
    // switch exactly, in the SAME change — see that file's V1230.84 note for why a mismatch here
    // silently rejects every claim of the changed type (same failure mode as the 1230.59/.60 history
    // above). Achievement/mission/competition rewards are untouched (different mechanic).
    function rewardAmountValid() { return (request.resource.data.type == 'challenge_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'mission_reward' && request.resource.data.amount in [1,2]) || (request.resource.data.type == 'competition_reward' && request.resource.data.amount in [1,5]) || (request.resource.data.type == 'achievement_reward' && request.resource.data.amount == 1) || (request.resource.data.type == 'story_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'health_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'beauty_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'horror_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'light_escape_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'light_escape_epic_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'beauty_epic_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'forensic_epic_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'puzzle_epic_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'story_epic_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'health_epic_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'football_epic_reward' && request.resource.data.amount == 5) || (request.resource.data.type == 'share_reward' && request.resource.data.amount == 1) || (request.resource.data.type == 'legend_reward' && request.resource.data.amount == 5); }
    function validRewardClaim(claimId) {
      return request.resource.data.claimId == claimId
        && request.resource.data.status == 'consumed'
        && request.resource.data.consumedAt == request.time
        && rewardTypeValid()
        && rewardAmountValid()
        // SECURITY FIX (was dead code): a challenge_reward claim must also satisfy
        // perfectClaim() below, otherwise any signed-in user could mint 5 ZIVO
        // by writing a matching document directly, without ever playing.
        && (request.resource.data.type != 'challenge_reward' || perfectClaim())
        && (request.resource.data.type != 'mission_reward' || request.resource.data.policy == 'mission_reward')
        && (request.resource.data.type != 'competition_reward' || request.resource.data.policy == 'competition_reward')
        && (request.resource.data.type != 'achievement_reward' || request.resource.data.policy == 'achievement_reward')
        && (request.resource.data.type != 'story_reward' || request.resource.data.policy == 'story_reward')
        && (request.resource.data.type != 'health_reward' || request.resource.data.policy == 'health_reward')
        && (request.resource.data.type != 'beauty_reward' || request.resource.data.policy == 'beauty_reward')
        && (request.resource.data.type != 'horror_reward' || request.resource.data.policy == 'horror_reward')
        && (request.resource.data.type != 'light_escape_reward' || request.resource.data.policy == 'light_escape_reward')
        && (request.resource.data.type != 'light_escape_epic_reward' || request.resource.data.policy == 'light_escape_epic_reward')
        && (request.resource.data.type != 'beauty_epic_reward' || request.resource.data.policy == 'beauty_epic_reward')
        && (request.resource.data.type != 'forensic_epic_reward' || request.resource.data.policy == 'forensic_epic_reward')
        && (request.resource.data.type != 'puzzle_epic_reward' || request.resource.data.policy == 'puzzle_epic_reward')
        && (request.resource.data.type != 'story_epic_reward' || request.resource.data.policy == 'story_epic_reward')
        && (request.resource.data.type != 'health_epic_reward' || request.resource.data.policy == 'health_epic_reward')
        && (request.resource.data.type != 'football_epic_reward' || request.resource.data.policy == 'football_epic_reward')
        && (request.resource.data.type != 'share_reward' || request.resource.data.policy == 'share_reward')
        && (request.resource.data.type != 'legend_reward' || request.resource.data.policy == 'legend_reward');
    }
    function validMiningKeys() { return request.resource.data.keys().hasOnly(['lastMiningAt','nextMiningAt','amount','version']); }
    // V1230.89 — this used to hardcode an exact question count (10, then briefly 20) that had to be
    // kept in sync by hand across this file AND economy.js/challenges.js/functions/* every time the
    // room's question count changed — and each time it drifted, EVERY challenge_reward claim was
    // silently rejected (see the dated history this replaces: V1230.84 changed the paid amount without
    // updating this function, then V1230.88 found total/correct were ALSO still hardcoded to the old
    // count). Checking correct==total generically — a real perfect run, whatever the round's actual
    // size is — removes the whole class of bug: a future count change needs no edit here at all.
    // total>0 keeps an empty/zero-length claim from vacuously satisfying correct==total (0==0).
    function perfectClaim() {
      return request.resource.data.amount == 5
        && request.resource.data.total > 0
        && request.resource.data.correct == request.resource.data.total
        && request.resource.data.timedOut == 0
        && request.resource.data.status == 'consumed'
        && request.resource.data.policy == 'perfect_score_only'
        && request.resource.data.source == 'game-platform'
        && request.resource.data.validated == true
        && request.resource.data.validatedSessionId is string
        && request.resource.data.validatedSessionId.size() > 5
        // V1230.61 — the historical gap this was flagged for: challenges.js self-asserted this whole
        // "perfect 10/10" shape client-side with nothing here tying it to real elapsed time, so a
        // console one-liner could mint an unlimited stream of fake claims instantly. Now cross-checked
        // against users/{uid}/zivozone/gameSession (economy.js's startGameSession(), written when a
        // real round genuinely begins, server-timestamped): the claimed session must exist, match this
        // claim's game, and at least 15s of real server-measured time must separate its start from
        // this claim. Not a complete anti-cheat — there is no server compute on the free Spark plan to
        // replay the actual 10 answers — but it closes the zero-effort, zero-elapsed-time forgery, and
        // the gameSession doc's own update cooldown (see that match block) stops pre-staging many
        // sessions to batch-drain claims once the window opens for all of them at once.
        && request.resource.data.challenge is string && request.resource.data.challenge.size() > 0
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/zivozone/gameSession)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/zivozone/gameSession).data.sessionId == request.resource.data.validatedSessionId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/zivozone/gameSession).data.gameId == request.resource.data.challenge
        && request.time >= get(/databases/$(database)/documents/users/$(request.auth.uid)/zivozone/gameSession).data.startedAt + duration.value(15, 's');
    }

    match /users/{userId} {
      allow read: if isOwner() || isSelf(userId);
      allow create: if isOwner() || (isSelf(userId) && request.resource.data.keys().hasOnly(['uid','email','name','role','createdAt','updatedAt','language','age','lastSeenAt','lastSeenPath','engagement','termsAcceptedAt','termsVersion']));
      allow update: if isOwner() || (isSelf(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','zivo','coins']));
      allow delete: if false;

      match /activity/{eventId} {
        allow read: if isOwner() || isSelf(userId);
        allow create: if isSelf(userId) && request.resource.data.keys().hasOnly(['event','meta','createdAt','uid']) && request.resource.data.event is string && request.resource.data.event.size() <= 80 && request.resource.data.uid == userId && request.resource.data.createdAt == request.time;
        allow update,delete: if false;
      }

      match /zivozone/wallet {
        allow read: if isOwner() || isSelf(userId);
        allow create: if isSelf(userId) && validWalletKeys() && request.resource.data.zivo == 0;
        allow update: if isOwner() || (isSelf(userId) && validWalletKeys() && request.resource.data.updatedAt == request.time && (
          (request.resource.data.zivo == resource.data.zivo + 0.5 &&
            getAfter(/databases/$(database)/documents/users/$(userId)/zivozone/mining).data.amount == 0.5 &&
            getAfter(/databases/$(database)/documents/users/$(userId)/zivozone/mining).data.nextMiningAt >= request.time + duration.value(86400, 's') &&
            getAfter(/databases/$(database)/documents/users/$(userId)/zivozone/mining).data.lastMiningAt == request.time) ||
          (request.resource.data.zivo > resource.data.zivo &&
            request.resource.data.lastRewardClaimId is string &&
            // V1230.68: rewardClaims is a sibling of zivozone now, not nested under it — see the fix note at match /rewardClaims/{claimId} below.
            getAfter(/databases/$(database)/documents/users/$(userId)/rewardClaims/$(request.resource.data.lastRewardClaimId)).data.status == 'consumed' &&
            getAfter(/databases/$(database)/documents/users/$(userId)/rewardClaims/$(request.resource.data.lastRewardClaimId)).data.amount == request.resource.data.zivo - resource.data.zivo &&
            getAfter(/databases/$(database)/documents/users/$(userId)/rewardClaims/$(request.resource.data.lastRewardClaimId)).data.consumedAt == request.time)
        ));
        allow delete: if false;
      }

      match /zivozone/mining {
        allow read: if isOwner() || isSelf(userId);
        allow create: if isSelf(userId) && validMiningKeys()
          && request.resource.data.amount == 0.5
          && request.resource.data.lastMiningAt == request.time
          && request.resource.data.nextMiningAt >= request.time + duration.value(86400, 's');
        allow update: if isSelf(userId) && validMiningKeys()
          && resource.data.nextMiningAt <= request.time
          && request.resource.data.amount == 0.5
          && request.resource.data.lastMiningAt == request.time
          && request.resource.data.nextMiningAt >= request.time + duration.value(86400, 's');
        allow delete: if false;
      }

      // V1230.61 — one fixed doc, not an unbounded subcollection (same shape as wallet/mining
      // above): a real challenge round's start, anchored with request.time so the client can't lie
      // about when it began. The update cooldown below is the actual rate limit — it stops an
      // attacker from pre-creating many sessions in a burst and draining them all at once the moment
      // perfectClaim()'s minimum-elapsed-time window opens for all of them simultaneously; only one
      // session can be "in flight" at a time, and starting a new one requires waiting out the last.
      match /zivozone/gameSession {
        allow read: if isOwner() || isSelf(userId);
        allow create: if isSelf(userId) && validGameSessionKeys() && validGameSessionShape();
        allow update: if isSelf(userId) && validGameSessionKeys() && validGameSessionShape()
          && resource.data.startedAt + duration.value(15, 's') <= request.time;
        allow delete: if false;
      }

      // V1230.69 — dead-code audit: removed the singular `zivozone/rewardClaim` rule that used to be
      // here. No JS anywhere references a 'rewardClaim' document id (singular) — confirmed by search
      // — and it already denied all writes (allow write: if false), so removing it changes nothing
      // functionally. The real, actively-used claim path is the plural `rewardClaims/{claimId}`
      // collection just below (moved to be a sibling of `zivozone` in V1230.68's reward-path fix).

      // V1230.68 — CRITICAL FIX: this was previously nested as `match /zivozone/rewardClaims/{claimId}`,
      // which is not a reachable document path. 'zivozone' (see /zivozone/wallet etc. above) is a
      // COLLECTION (users/{userId}/zivozone); a collection's children are documents, not more
      // collections, so "zivozone/rewardClaims/{claimId}" is a 3-segment (odd = collection-level) path,
      // not a document — the matching economy.js code tried to reach it via
      // root(uid).collection('rewardClaims'), i.e. .collection() on a CollectionReference, which the
      // Firestore SDK does not support and throws at runtime. Moved here as a sibling of 'zivozone'
      // (users/{userId}/rewardClaims/{claimId} — 4 segments, even, a real document), matching
      // economy.js's corrected rewardClaims(uid) helper.
      match /rewardClaims/{claimId} {
        allow read: if isOwner() || isSelf(userId);
        allow create: if isSelf(userId) && validRewardClaim(claimId);
        allow update,delete: if false;
      }

      match /zivozone/wallet/ledger/{entryId} {
        allow read: if isOwner() || isSelf(userId);
        allow create: if isSelf(userId) && (
          (
            request.resource.data.type == 'daily_mining'
            && request.resource.data.amount == 0.5
            && request.resource.data.eventId == entryId
            && request.resource.data.policy == '24h_mining'
            && getAfter(/databases/$(database)/documents/users/$(userId)/zivozone/mining).data.amount == 0.5
            && getAfter(/databases/$(database)/documents/users/$(userId)/zivozone/mining).data.nextMiningAt >= request.time + duration.value(86400, 's') &&
            getAfter(/databases/$(database)/documents/users/$(userId)/zivozone/mining).data.lastMiningAt == request.time
          )
          ||
          (
            request.resource.data.eventId == entryId
            && request.resource.data.claimId == entryId
            // V1230.68: rewardClaims is a sibling of zivozone now, not nested under it — see the fix note at match /rewardClaims/{claimId}.
            && getAfter(/databases/$(database)/documents/users/$(userId)/rewardClaims/$(entryId)).data.status == 'consumed'
            && getAfter(/databases/$(database)/documents/users/$(userId)/rewardClaims/$(entryId)).data.amount == request.resource.data.amount
            && ((request.resource.data.type == 'challenge_reward' && request.resource.data.amount == 10)
              || (request.resource.data.type == 'mission_reward' && request.resource.data.amount in [1,2])
              || (request.resource.data.type == 'competition_reward' && request.resource.data.amount in [1,5])
              || (request.resource.data.type == 'achievement_reward' && request.resource.data.amount == 1)
              || (request.resource.data.type == 'story_reward' && request.resource.data.amount == 2)
              || (request.resource.data.type == 'health_reward' && request.resource.data.amount == 2)
              || (request.resource.data.type == 'beauty_reward' && request.resource.data.amount == 2)
              || (request.resource.data.type == 'horror_reward' && request.resource.data.amount == 2)
              || (request.resource.data.type == 'light_escape_reward' && request.resource.data.amount == 2)
              || (request.resource.data.type == 'light_escape_epic_reward' && request.resource.data.amount == 5)
              || (request.resource.data.type == 'beauty_epic_reward' && request.resource.data.amount == 5)
              || (request.resource.data.type == 'forensic_epic_reward' && request.resource.data.amount == 5)
              || (request.resource.data.type == 'puzzle_epic_reward' && request.resource.data.amount == 5)
              || (request.resource.data.type == 'story_epic_reward' && request.resource.data.amount == 5)
              || (request.resource.data.type == 'health_epic_reward' && request.resource.data.amount == 5)
              || (request.resource.data.type == 'football_epic_reward' && request.resource.data.amount == 5))
          )
        );
        allow update,delete: if false;
      }
    }

    match /players/{uid} {
      allow read: if isOwner() || isSelf(uid);
      allow create: if isSelf(uid) && request.resource.data.get('zivo', 0) == 0 && request.resource.data.get('coins', 0) == 0;
      allow update: if isOwner() || (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['zivo','coins']) && (validProgressUpdate() || validProfileUpdate() || validPresenceUpdate()));
      match /events/{eventId} { allow read: if isOwner() || isSelf(uid); allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['event','meta','createdAt']) && request.resource.data.event is string && request.resource.data.event.size() <= 80 && request.resource.data.createdAt == request.time; allow update,delete: if false; }
      match /results/{resultId} { allow read: if isOwner() || isSelf(uid); allow create: if isSelf(uid) && request.resource.data.keys().size() <= 30 && request.resource.data.createdAt == request.time; allow update,delete: if false; }
      match /attempts/{attemptId} { allow read: if isOwner() || isSelf(uid); allow create: if isSelf(uid); allow update,delete: if false; }
      match /gameAttempts/{attemptId} { allow read,create: if isOwner() || isSelf(uid); allow update,delete: if false; }
      match /wallet/{doc} { allow read: if isOwner() || isSelf(uid); allow write: if false; }
    }

    // V1230.68 — zero-cost client-side error tracking; see validErrorLog() above and
    // core/modules/runtime/error-tracker.js. Anyone (signed in or not) may create a log entry so
    // real errors are never lost to a missing sign-in; only the admin can read them back, and
    // nothing can ever be edited or removed once written.
    match /errorLogs/{errorId} {
      allow read: if isOwner();
      allow create: if validErrorLog();
      allow update, delete: if false;
    }

    match /questions/{id} { allow read: if signedIn(); allow write: if false; }
    match /dailyChallenges/{id} { allow read: if signedIn(); allow write: if false; }
    // SECURITY FIX: this top-level collection had no consumers anywhere in the app (only the
    // per-user players/{uid}/results below is used) and allowed any signed-in user to create an
    // unbounded, unvalidated document here — an open write surface to a shared collection with no
    // real purpose. Denied outright; re-open with real validation if a feature needs it.
    match /results/{id} { allow read: if signedIn(); allow write: if false; }
    match /wallets/{uid} { allow read: if isOwner() || isSelf(uid); allow write: if false; }
    match /leaderboard/{id} {
      allow read: if true;
      allow create, update: if isSelf(id) && validLeaderboardEntry(id);
      allow delete: if false;
    }
    match /admins/{uid} { allow read: if isOwner() && request.auth.uid == uid; allow write: if false; }
    match /siteStats/visitors/{day}/{visitorId} { allow read: if isOwner(); allow create,update: if request.resource.data.type == 'guest' && request.resource.data.status == 'visitor' && request.resource.data.visitorId == visitorId && visitorId.size() <= 64 && request.resource.data.keys().hasOnly(['visitorId','type','status','firstSeenAt','lastSeenAt','lastSeenPath','referrer','language','userAgent','updatedAt']) && request.resource.data.lastSeenAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.lastSeenPath.size() <= 100 && request.resource.data.referrer.size() <= 200 && request.resource.data.language.size() <= 10 && request.resource.data.userAgent.size() <= 180; allow delete: if false; }
    match /siteStats/{document=**} { allow read: if isOwner(); allow write: if false; }
    match /publicChat/{messageId} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/publicChatBans/$(request.auth.uid))
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.keys().hasOnly(['text','displayName','authorUid','language','createdAt'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40))
        && (!('language' in request.resource.data) || (request.resource.data.language is string && request.resource.data.language.size() <= 10))
        && request.resource.data.createdAt == request.time
        && ((!exists(/databases/$(database)/documents/publicChatRate/$(request.auth.uid))) || get(/databases/$(database)/documents/publicChatRate/$(request.auth.uid)).data.nextAllowedAt <= request.time)
        && getAfter(/databases/$(database)/documents/publicChatRate/$(request.auth.uid)).data.nextAllowedAt >= request.time + duration.value(3, 's');
      allow delete: if isOwner();
      allow update: if false;
    }
    match /publicChatRate/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.nextAllowedAt >= request.time + duration.value(3, 's');
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && resource.data.nextAllowedAt <= request.time
        && request.resource.data.nextAllowedAt >= request.time + duration.value(3, 's');
      allow delete: if isOwner();
    }
    // Online-count heartbeat written by core/modules/chat.js (was missing → every write/read was denied).
    match /publicChatPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','lastSeen'])
        && request.resource.data.uid == uid
        && request.resource.data.lastSeen == request.time;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }
    match /publicChatBans/{uid} {
      allow read: if isOwner();
      allow create,update: if isOwner() && request.resource.data.uid == uid;
      allow delete: if isOwner();
    }
        match /public/{document=**} { allow read: if true; allow write: if false; }

    // V1230.114 — short links for "challenge a friend" (duel) and "invite friends" (referral).
    // Problem: those links used to carry the full target inline as query params
    // (?challenger=&cscore=&utm_source=...&utm_medium=...&utm_campaign=...), which made a shared
    // link long, and to a non-technical recipient (this is a Jordanian/MENA audience, per
    // share.js's whatsapp-first fallback) a URL trailing a wall of unfamiliar parameters reads as
    // suspicious rather than trustworthy — exactly the opposite of what a "first visit" link should
    // feel like. Fix: share.js now mints a short random code, writes the real target here once, and
    // shares plain https://zivozone.com/d/<code> instead; router.js resolves the code back to the
    // full target on load (see that file's "shortlink" route type) and only ever constructs the SAME
    // query-param shape that already worked before — no new client-side trust surface, just a shorter
    // door into the existing flow. Same zero-auth-required shape as errorLogs above (a guest who just
    // finished a challenge, signed in or not, must be able to mint one): anyone may create a doc, but
    // only with this exact narrow, size-capped, enum-typed shape, and it can never be edited or
    // deleted once written — a share link is meant to be read-only and short-lived in spirit, even
    // though nothing here actively expires it yet.
    match /shortLinks/{code} {
      allow read: if true;
      allow create: if code.size() >= 5 && code.size() <= 12
        && request.resource.data.keys().hasOnly(['type','gameId','challenger','score','uid','createdAt'])
        && request.resource.data.type in ['duel','invite']
        && request.resource.data.createdAt == request.time
        && (request.resource.data.type != 'duel' ||
          (request.resource.data.gameId is string && request.resource.data.gameId.size() > 0 && request.resource.data.gameId.size() <= 80
            && request.resource.data.challenger is string && request.resource.data.challenger.size() <= 24
            && (!('score' in request.resource.data) || request.resource.data.score is number)))
        && (request.resource.data.type != 'invite' ||
          (request.resource.data.uid is string && request.resource.data.uid.size() <= 64));
      allow update, delete: if false;
    }

    // V1230.123 — "Beyond Time" room's live community truth-meter (rooms.js's voteTruth()): an
    // anonymous, unauthenticated public counter per claim (timeVotes/{doorId} = {fact, illusion}),
    // same threat model as shortLinks above (public write, no auth required, worst case is click-spam
    // skewing a fun stat, not a security issue). Each write may ONLY increment exactly one of the two
    // counters by exactly 1 and must not touch the other — blocks both a "set my vote count to
    // 999999" forgery and a write that tries to change both fields in one call.
    match /timeVotes/{doorId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['fact','illusion'])
        && ((request.resource.data.fact == 1 && request.resource.data.illusion == 0)
          || (request.resource.data.illusion == 1 && request.resource.data.fact == 0));
      allow update: if request.resource.data.keys().hasOnly(['fact','illusion'])
        && ((request.resource.data.fact == resource.data.get('fact', 0) + 1 && request.resource.data.illusion == resource.data.get('illusion', 0))
          || (request.resource.data.illusion == resource.data.get('illusion', 0) + 1 && request.resource.data.fact == resource.data.get('fact', 0)));
      allow delete: if false;
    }

    /* V1230.68 — FUTURE TIGHTENING, INERT, NOT ACTIVE. ===============================================
       Written alongside functions/index.js (real server-side game-result verification; see that
       file's header for full context and deploy steps) for the day the user upgrades off the free
       Spark plan and deploys Cloud Functions. Everything below this line is a comment, not a rule —
       it changes NOTHING about current behavior. Once Cloud Functions are deployed and trusted:

       Replace perfectClaim()'s current client-attested shape check:
         function perfectClaim() {
           return request.resource.data.amount == 10 && ... && request.resource.data.source == 'game-platform' ...
         }
       with a check that the claim was written by the Cloud Function specifically (which uses the
       Admin SDK and so is never actually evaluated against these rules at all — Admin SDK writes
       bypass firestore.rules entirely). The real tightening is therefore not a rule change here, but
       a CLIENT change: once functions/index.js is deployed and server-verify.js's
       CLOUD_FUNCTIONS_ENABLED flag is on and proven reliable, economy.js's own client-side
       'zivozone-result' listener (onChallenge/rewardPerfect in core/modules/economy.js) can be
       retired, leaving the Cloud Function as the ONLY path that can ever write a challenge_reward
       claim — at which point perfectClaim()'s whole client-attested-shape check becomes moot and
       could be replaced with simply `allow create: if false;` for type=='challenge_reward' claims
       (only the Admin SDK, which ignores these rules, could still write one). That is a deliberate,
       separate, future change — not made now, since the client-side path is still the ONLY working
       path today and must keep working until the server path is deployed and verified for real.
    ================================================================================================= */
  }
}
