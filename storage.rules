rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reels/{fileName} {
      allow read: if true;
      // V1230.132 — defense-in-depth consistency fix: firestore.rules' isOwner() has always required
      // email_verified==true too ("an unverified e-mail must never grant admin rights"), but this
      // file's admin check never did. Firebase Auth does not allow a second account to register the
      // exact same email, so this gap was not directly exploitable today — but it's cheap to close
      // and keeps both rule files enforcing the admin check the same way.
      allow write: if request.auth != null
        && request.auth.token.email == 'raefalbtish@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
      allow delete: if request.auth != null
        && request.auth.token.email == 'raefalbtish@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
